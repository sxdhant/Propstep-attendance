# Copy to .env.local (development) or set these in your host (production).
# Development works with no variables at all: it falls back to the local database from `npm run db:dev`.

# --- required in production ---------------------------------------------------
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/attendance
# TLS: true = verify the certificate (Neon). no-verify = encrypted, unverified (Supabase default certs);
# or keep true and put the provider's CA certificate in DATABASE_SSL_CA. Required for any non-local production database.
DATABASE_SSL=true
# DATABASE_SSL_CA=
# Direct (non-pooled) URL used only by `npm run db:migrate` / `db:seed`. Recommended behind a pooler.
# MIGRATE_DATABASE_URL=
# Max connections per app instance. Use 1-3 on serverless hosts behind a pooler.
# DATABASE_POOL_MAX=10
# Public origin of the site (no trailing slash). Used for reset links and the CSRF origin check.
APP_URL=https://attendance.propstep.in
# 32+ random characters; encrypts two-factor secrets at rest. Losing it disables everyone's 2FA.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# --- recommended --------------------------------------------------------------
# Set only when behind a reverse proxy you control, so X-Forwarded-For can be trusted for rate limits.
TRUST_PROXY=true
# Password-reset email (Resend). Without it, reset links cannot be sent in production.
RESEND_API_KEY=
MAIL_FROM="Propstep <no-reply@propstep.in>"

# --- first administrator (read once by `npm run db:seed`) -----------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- optional -----------------------------------------------------------------
# Days to keep audit entries (0 = forever). Used by `npm run db:cleanup`.
AUDIT_RETENTION_DAYS=400
